            },
            "description": "O login ganha um numero aleatorio pra collection poder rodar varias vezes sem dar login repetido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"funcionarioId\", pm.response.json().id);",
                  "pm.test(\"cargo = FUNCIONARIO\", () => pm.expect(pm.response.json().cargo).to.eql(\"FUNCIONARIO\"));",
                  "pm.test(\"senha nao aparece na resposta\", () => pm.expect(pm.response.json()).to.not.have.property(\"senha\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.collectionVariables.set('loginFuncionario', 'joao' + Math.floor(Math.random() * 100000));",
                  "}"
                ]
              }
            }
