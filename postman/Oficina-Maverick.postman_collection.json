            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "// data futura aleatoria (1 a 20 dias, 8h-17h) pra nao bater horario se rodar de novo",
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "const d = new Date(Date.now() + (1 + Math.floor(Math.random() * 20)) * 24 * 60 * 60 * 1000);",
                  "d.setHours(8 + Math.floor(Math.random() * 10), Math.floor(Math.random() * 60), 0, 0);",
                  "pm.collectionVariables.set('dataAgendamento',",
                  "  `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`);",
                  "}"
                ]
              }
            }
          ]
