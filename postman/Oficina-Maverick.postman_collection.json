{
  "info": {
    "name": "Oficina Maverick - API",
    "description": "Fluxo completo dos casos de uso UC01 a UC08. Rode na ordem (ou pelo Collection Runner): o login salva o token e cada cadastro salva o id usado nos passos seguintes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenFuncionario",
      "value": ""
    },
    {
      "key": "funcionarioId",
      "value": ""
    },
    {
      "key": "loginFuncionario",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "agendamentoId",
      "value": ""
    },
    {
      "key": "ordemId",
      "value": ""
    },
    {
      "key": "dataAgendamento",
      "value": ""
    },
    {
      "key": "inicio",
      "value": ""
    },
    {
      "key": "fim",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "{",
          "// periodo usado nos relatorios: 30 dias pra tras ate 30 dias pra frente",
          "const pad = (n) => String(n).padStart(2, '0');",
          "const data = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "const dia = 24 * 60 * 60 * 1000;",
          "pm.collectionVariables.set('inicio', data(new Date(Date.now() - 30 * dia)));",
          "pm.collectionVariables.set('fim', data(new Date(Date.now() + 30 * dia)));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "UC01 - Login",
      "item": [
        {
          "name": "Login com senha errada (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"errada\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
